<Window x:Class="LeagueClanker.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:LeagueClanker.App"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance local:MainViewModel}"
        Title="LeagueClanker"
        Width="400" SizeToContent="Height" MaxHeight="920" MinWidth="360"
        Topmost="True" WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="CanResizeWithGrip" ShowInTaskbar="True"
        FontFamily="Segoe UI" Foreground="{StaticResource TextBrush}">

    <Window.Resources>
        <!-- Shared column layout for the stats tables: icon, name, level, AD, AP, armor, MR, HP, AS, crit -->
        <ControlTemplate x:Key="PlayerHeader" TargetType="ContentControl">
            <Grid Margin="4,0,4,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="18" /><ColumnDefinition Width="*" /><ColumnDefinition Width="24" />
                    <ColumnDefinition Width="34" /><ColumnDefinition Width="34" /><ColumnDefinition Width="36" />
                    <ColumnDefinition Width="32" /><ColumnDefinition Width="42" /><ColumnDefinition Width="34" />
                    <ColumnDefinition Width="32" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="2" Style="{StaticResource StatHeader}" Text="lvl" />
                <TextBlock Grid.Column="3" Style="{StaticResource StatHeader}" Text="AD" />
                <TextBlock Grid.Column="4" Style="{StaticResource StatHeader}" Text="AP" />
                <TextBlock Grid.Column="5" Style="{StaticResource StatHeader}" Text="armor" />
                <TextBlock Grid.Column="6" Style="{StaticResource StatHeader}" Text="MR" />
                <TextBlock Grid.Column="7" Style="{StaticResource StatHeader}" Text="HP" />
                <TextBlock Grid.Column="8" Style="{StaticResource StatHeader}" Text="AS" />
                <TextBlock Grid.Column="9" Style="{StaticResource StatHeader}" Text="crit" />
            </Grid>
        </ControlTemplate>

        <DataTemplate x:Key="PlayerRowTemplate" DataType="{x:Type local:PlayerRow}">
            <Border Background="{StaticResource CardBrush}" CornerRadius="4" Padding="4,3" Margin="0,0,0,3" ToolTip="{Binding Note}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="18" /><ColumnDefinition Width="*" /><ColumnDefinition Width="24" />
                        <ColumnDefinition Width="34" /><ColumnDefinition Width="34" /><ColumnDefinition Width="36" />
                        <ColumnDefinition Width="32" /><ColumnDefinition Width="42" /><ColumnDefinition Width="34" />
                        <ColumnDefinition Width="32" />
                    </Grid.ColumnDefinitions>
                    <Image Source="{Binding IconUrl}" Width="18" Height="18" />
                    <TextBlock x:Name="Name" Grid.Column="1" Text="{Binding Name}" FontSize="11" Margin="6,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Column="2" Style="{StaticResource StatCell}" Text="{Binding Level}" Foreground="{StaticResource MutedBrush}" />
                    <Border Grid.Column="3" Background="{Binding AdHeat}" CornerRadius="3" Margin="1,0"><TextBlock Style="{StaticResource StatCell}" Text="{Binding AttackDamage, StringFormat={}{0:0}}" Margin="0,0,3,0" /></Border>
                    <Border Grid.Column="4" Background="{Binding ApHeat}" CornerRadius="3" Margin="1,0"><TextBlock Style="{StaticResource StatCell}" Text="{Binding AbilityPower, StringFormat={}{0:0}}" Margin="0,0,3,0" /></Border>
                    <Border Grid.Column="5" Background="{Binding ArmorHeat}" CornerRadius="3" Margin="1,0"><TextBlock Style="{StaticResource StatCell}" Text="{Binding Armor, StringFormat={}{0:0}}" Margin="0,0,3,0" /></Border>
                    <Border Grid.Column="6" Background="{Binding MrHeat}" CornerRadius="3" Margin="1,0"><TextBlock Style="{StaticResource StatCell}" Text="{Binding MagicResist, StringFormat={}{0:0}}" Margin="0,0,3,0" /></Border>
                    <Border Grid.Column="7" Background="{Binding HpHeat}" CornerRadius="3" Margin="1,0"><TextBlock Style="{StaticResource StatCell}" Text="{Binding Health, StringFormat={}{0:0}}" Margin="0,0,3,0" /></Border>
                    <TextBlock Grid.Column="8" Style="{StaticResource StatCell}" Text="{Binding AttackSpeed, StringFormat={}{0:0.00}}" />
                    <TextBlock Grid.Column="9" Style="{StaticResource StatCell}" Text="{Binding CritChance, StringFormat={}{0:0}%}" />
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsMe}" Value="True">
                    <Setter TargetName="Name" Property="Foreground" Value="{StaticResource AccentBrush}" />
                    <Setter TargetName="Name" Property="FontWeight" Value="SemiBold" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
        <!-- An enemy as a card: why they matter, their damage split and how tough they are -->
        <DataTemplate x:Key="ThreatCardTemplate" DataType="{x:Type local:PlayerRow}">
            <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="10,8" Margin="0,0,0,6"
                    ToolTip="{Binding Note}">
                <DockPanel>
                    <Border DockPanel.Dock="Left" Width="36" Height="36" CornerRadius="6" ClipToBounds="True" Margin="0,0,10,0"><Image Source="{Binding IconUrl}" /></Border>
                    <Grid DockPanel.Dock="Right" Width="150" VerticalAlignment="Center" Margin="10,0,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="56" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="damage" Foreground="{StaticResource MutedBrush}" FontSize="10" />
                        <Grid Grid.Column="1" Height="5" VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="{Binding DamageAd}" />
                                <ColumnDefinition Width="{Binding DamageAp}" />
                            </Grid.ColumnDefinitions>
                            <Border Background="{StaticResource AdBrush}" CornerRadius="2,0,0,2" />
                            <Border Grid.Column="1" Background="{StaticResource ApBrush}" CornerRadius="0,2,2,0" />
                        </Grid>
                        <TextBlock Grid.Row="1" Text="toughness" Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="0,4,0,0" />
                        <Grid Grid.Row="1" Grid.Column="1" Height="5" VerticalAlignment="Center" Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="{Binding Tough}" />
                                <ColumnDefinition Width="{Binding NotTough}" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.ColumnSpan="2" Background="{StaticResource BorderBrush}" CornerRadius="2" />
                            <Border Background="#FFB9C1CA" CornerRadius="2" />
                        </Grid>
                    </Grid>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock>
                            <Run Text="{Binding Name, Mode=OneWay}" FontSize="13" FontWeight="SemiBold" /><Run Text="  level " Foreground="{StaticResource MutedBrush}" FontSize="11" /><Run Text="{Binding Level, Mode=OneWay}" Foreground="{StaticResource MutedBrush}" FontSize="11" />
                        </TextBlock>
                        <TextBlock Text="{Binding Threat}" Foreground="#FFB9C1CA" FontSize="11" TextWrapping="Wrap" />
                    </StackPanel>
                </DockPanel>
            </Border>
        </DataTemplate>

        <!-- A champion suggestion: icon, name, "you play this", win rate and games -->
        <DataTemplate x:Key="CounterRowTemplate" DataType="{x:Type local:CounterRow}">
            <Border Background="{StaticResource CardBrush}" CornerRadius="4" Padding="6,3" Margin="0,0,0,3">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Right" Text="{Binding Games}" Foreground="{StaticResource MutedBrush}" FontSize="10"
                               VerticalAlignment="Center" Margin="8,0,0,0" />
                    <TextBlock DockPanel.Dock="Right" Text="{Binding WinRate}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <Image Source="{Binding IconUrl}" Width="20" Height="20" />
                    <TextBlock Text="{Binding Name}" FontSize="11" Margin="6,0,0,0" VerticalAlignment="Center" />
                    <Border x:Name="Played" Visibility="Collapsed" BorderBrush="{StaticResource AccentBrush}" BorderThickness="1"
                            CornerRadius="3" Padding="4,0" Margin="6,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Left">
                        <TextBlock Text="you play this" Foreground="{StaticResource AccentBrush}" FontSize="9" />
                    </Border>
                </DockPanel>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding YouPlayIt}" Value="True">
                    <Setter TargetName="Played" Property="Visibility" Value="Visible" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <DataTemplate x:Key="RuneRowTemplate" DataType="{x:Type local:RuneRow}">
            <StackPanel Orientation="Horizontal" Margin="0,2">
                <Image Source="{Binding IconUrl}" Width="22" Height="22" />
                <TextBlock Text="{Binding Name}" FontSize="11" Margin="6,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </DataTemplate>
    </Window.Resources>

    <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8">
        <DockPanel>
            <!-- Title bar: drag to move -->
            <Grid DockPanel.Dock="Top" Height="34" Background="Transparent" MouseLeftButtonDown="OnTitleBarMouseDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <DockPanel VerticalAlignment="Center" Margin="12,0,4,0">
                    <TextBlock DockPanel.Dock="Left" Text="LeagueClanker" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" />
                    <TextBlock Text="{Binding Status}" ToolTip="{Binding Status}" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="10,1,0,0"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                </DockPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,6,0">
                    <Button Style="{StaticResource ChromeButton}" Content="&#x2913;" ToolTip="Save a snapshot of what the app sees (for bug reports)"
                            Click="OnSaveSnapshot" AutomationProperties.Name="Save snapshot" />
                    <Button Style="{StaticResource ChromeButton}" Content="&#x25AD;" ToolTip="Compact mode: just the next item, what to buy and the matchup"
                            Click="OnToggleCompact" AutomationProperties.Name="Compact mode" />
                    <Button Style="{StaticResource ChromeButton}" Content="&#x2699;" ToolTip="Settings" Click="OnToggleSettings" AutomationProperties.Name="Settings" />
                    <Button Style="{StaticResource ChromeButton}" Content="📌" ToolTip="Toggle always on top" Click="OnPinClick" />
                    <Button Style="{StaticResource ChromeButton}" Content="✕" ToolTip="Close" Click="OnCloseClick" />
                </StackPanel>
            </Grid>

            <StackPanel DockPanel.Dock="Bottom" Margin="12,4,12,8">
                <TextBlock Text="{Binding Notice}" Foreground="{StaticResource MutedBrush}" FontSize="10" TextWrapping="Wrap" Margin="0,0,0,3"
                           Visibility="{Binding Notice, Converter={StaticResource HasContent}}" />
                <DockPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource LinkButton}" Content="{Binding UpdateText}" Click="OnOpenUpdate"
                            Visibility="{Binding UpdateText, Converter={StaticResource HasContent}}" ToolTip="Open the download page" />
                    <TextBlock Text="{Binding Footer}" Foreground="{StaticResource MutedBrush}" FontSize="10" />
                </DockPanel>
            </StackPanel>

            <Grid>
            <!-- ===== Between games: the recap of a game, your recent games, your champions ===== -->
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="12,0,12,0"
                          Visibility="{Binding ShowHistory, Converter={StaticResource BoolToVisibility}}">
                <StackPanel Margin="0,8,0,6">
                    <Border BorderBrush="{StaticResource AccentBrush}" BorderThickness="1" CornerRadius="8" Background="#FF1C1A14" Padding="12,10"
                            Visibility="{Binding LastGameTitle, Converter={StaticResource HasContent}}">
                        <StackPanel>
                            <DockPanel>
                                <TextBlock Text="{Binding RecapResult}" FontSize="11" FontWeight="Bold" Margin="0,0,8,0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding RecapOutcome}" Value="win"><Setter Property="Foreground" Value="#FF5FBF77" /></DataTrigger>
                                                <DataTrigger Binding="{Binding RecapOutcome}" Value="loss"><Setter Property="Foreground" Value="#FFE8817E" /></DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Text="{Binding RecapDetail}" Foreground="{StaticResource MutedBrush}" FontSize="11" TextTrimming="CharacterEllipsis" />
                            </DockPanel>
                            <DockPanel Margin="0,8,0,0">
                                <Border DockPanel.Dock="Left" Width="40" Height="40" CornerRadius="6" ClipToBounds="True" Margin="0,0,10,0">
                                    <Image Source="{Binding RecapChampionIcon, TargetNullValue={x:Null}}" Stretch="UniformToFill" />
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding RecapChampion}" FontSize="16" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding RecapPlaystyle}" Foreground="{StaticResource MutedBrush}" FontSize="11" />
                                </StackPanel>
                            </DockPanel>
                            <ItemsControl ItemsSource="{Binding RecapSlots}" Margin="-3,10,-3,0">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><UniformGrid Columns="6" /></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type local:FinalSlot}">
                                        <Grid Width="44" Height="44" Margin="3" ToolTip="{Binding Name}">
                                            <Rectangle x:Name="Empty" RadiusX="6" RadiusY="6" Stroke="{StaticResource BorderBrush}" StrokeDashArray="4 3" Visibility="Collapsed" />
                                            <Border x:Name="Icon" CornerRadius="6" ClipToBounds="True">
                                                <Image Source="{Binding IconUrl, TargetNullValue={x:Null}}" />
                                            </Border>
                                            <Border x:Name="Check" Width="16" Height="16" CornerRadius="8" Background="#FF5FBF77" HorizontalAlignment="Right" VerticalAlignment="Top"
                                                    Margin="0,-5,-3,0" Visibility="Collapsed" ToolTip="In LeagueClanker's build">
                                                <TextBlock Text="&#x2713;" FontSize="10" FontWeight="Bold" Foreground="{StaticResource PanelBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                        </Grid>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsEmpty}" Value="True">
                                                <Setter TargetName="Empty" Property="Visibility" Value="Visible" />
                                                <Setter TargetName="Icon" Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Advised}" Value="True">
                                                <Setter TargetName="Check" Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="{Binding RecapBuilt}" FontSize="12" Foreground="#FFB9C1CA" TextWrapping="Wrap" Margin="0,6,0,0"
                                       Visibility="{Binding RecapBuilt, Converter={StaticResource HasContent}}" />
                            <StackPanel Visibility="{Binding RecapPivots, Converter={StaticResource HasContent}}">
                                <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,10,0,8" />
                                <ItemsControl ItemsSource="{Binding RecapPivots}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type local:PivotLine}">
                                            <DockPanel Margin="0,0,0,5">
                                                <TextBlock DockPanel.Dock="Left" Text="{Binding Time}" Foreground="{StaticResource MutedBrush}" FontSize="11" Width="38" VerticalAlignment="Center" />
                                                <Border x:Name="Chip" DockPanel.Dock="Left" BorderBrush="{StaticResource MutedBrush}" BorderThickness="1" CornerRadius="4" Padding="6,0" Margin="0,0,8,0" VerticalAlignment="Center">
                                                    <TextBlock x:Name="ChipText" Text="kept yours" FontSize="10" Foreground="{StaticResource MutedBrush}" />
                                                </Border>
                                                <TextBlock Text="{Binding Text}" FontSize="11" Foreground="#FFB9C1CA" TextWrapping="Wrap" VerticalAlignment="Center" />
                                            </DockPanel>
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding Took}" Value="True">
                                                    <Setter TargetName="Chip" Property="BorderBrush" Value="#FF5FBF77" />
                                                    <Setter TargetName="ChipText" Property="Foreground" Value="#FF5FBF77" />
                                                    <Setter TargetName="ChipText" Property="Text" Value="took" />
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                            <TextBlock Text="{Binding RecapCards}" Foreground="{StaticResource MutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"
                                       Visibility="{Binding RecapCards, Converter={StaticResource HasContent}}" />
                        </StackPanel>
                    </Border>

                    <!-- Your recent games: click one to show it above -->
                    <StackPanel Visibility="{Binding RecentGames, Converter={StaticResource HasContent}}">
                        <DockPanel Margin="0,12,0,5">
                            <TextBlock DockPanel.Dock="Right" Text="{Binding GamesSummary}" Foreground="{StaticResource MutedBrush}" FontSize="11" VerticalAlignment="Bottom" />
                            <TextBlock Text="YOUR GAMES" Foreground="{StaticResource AccentBrush}" FontSize="10" FontWeight="Bold" VerticalAlignment="Bottom" />
                        </DockPanel>
                        <ItemsControl ItemsSource="{Binding RecentGames}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type local:GameRow}">
                                    <Button Click="OnSelectGame" Cursor="Hand" AutomationProperties.Name="{Binding ChampionName, StringFormat=Show game as {0}}">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="Row" BorderBrush="Transparent" BorderThickness="1" CornerRadius="6" Padding="8,6" Margin="0,0,0,2" Background="Transparent">
                                                    <ContentPresenter />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Row" Property="Background" Value="{StaticResource CardBrush}" />
                                                    </Trigger>
                                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                        <Setter TargetName="Row" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                                        <Setter TargetName="Row" Property="Background" Value="#FF1C1A14" />
                                                    </DataTrigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                        <DockPanel>
                                            <Border DockPanel.Dock="Left" Width="28" Height="28" CornerRadius="5" ClipToBounds="True" Margin="0,0,8,0">
                                                <Image Source="{Binding IconUrl}" />
                                            </Border>
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding Built}" Foreground="{StaticResource MutedBrush}" FontSize="11" VerticalAlignment="Center"
                                                       ToolTip="Your items that were in LeagueClanker's build" />
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock FontSize="12" Foreground="{StaticResource TextBrush}">
                                                    <Run x:Name="Result" Text="{Binding Result, Mode=OneWay}" FontWeight="SemiBold" Foreground="{StaticResource MutedBrush}" /><Run Text=" " /><Run Text="{Binding ChampionName, Mode=OneWay}" />
                                                </TextBlock>
                                                <TextBlock Text="{Binding Detail}" Foreground="{StaticResource MutedBrush}" FontSize="11" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </DockPanel>
                                    </Button>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding Win}" Value="True"><Setter TargetName="Result" Property="Foreground" Value="#FF5FBF77" /></DataTrigger>
                                        <DataTrigger Binding="{Binding Win}" Value="False"><Setter TargetName="Result" Property="Foreground" Value="#FFE8817E" /></DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <!-- Your champions, one line -->
                    <StackPanel Visibility="{Binding ChampionStats, Converter={StaticResource HasContent}}" Margin="0,10,0,0">
                        <ItemsControl ItemsSource="{Binding ChampionStats}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type local:ChampionStatRow}">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,14,6" ToolTip="{Binding Record}">
                                        <Border Width="20" Height="20" CornerRadius="10" ClipToBounds="True"><Image Source="{Binding IconUrl}" /></Border>
                                        <TextBlock FontSize="11" Margin="5,0,0,0" VerticalAlignment="Center" Foreground="#FFB9C1CA">
                                            <Run Text="{Binding Name, Mode=OneWay}" /><Run Text=" " /><Run Text="{Binding WinRate, Mode=OneWay}" FontWeight="SemiBold" />
                                        </TextBlock>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="{Binding StatsNote}" Foreground="{StaticResource MutedBrush}" FontSize="10" TextWrapping="Wrap" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <!-- ===== Champ select: playstyle and rune page ===== -->
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="12,0,12,0"
                          Visibility="{Binding ShowChampSelect, Converter={StaticResource BoolToVisibility}}">
                <StackPanel DataContext="{Binding ChampSelect}" Margin="0,2,0,8">
                    <DockPanel Margin="0,6,0,0">
                        <Border DockPanel.Dock="Left" Width="44" Height="44" CornerRadius="8" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                Margin="0,0,10,0" VerticalAlignment="Center" ClipToBounds="True"
                                Visibility="{Binding HasChampion, Converter={StaticResource BoolToVisibility}}">
                            <Image Source="{Binding ChampionIconUrl, TargetNullValue={x:Null}}" Stretch="UniformToFill" />
                        </Border>
                        <Border DockPanel.Dock="Right" BorderBrush="{StaticResource AccentBrush}" Background="#FF1C1A14" BorderThickness="1" CornerRadius="4"
                                Padding="7,1" VerticalAlignment="Center" Visibility="{Binding IsBanPhase, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="Ban phase" Foreground="{StaticResource AccentBrush}" FontSize="11" />
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding ChampionName}" FontSize="17" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding Situation}" Foreground="{StaticResource MutedBrush}" FontSize="11" />
                        </StackPanel>
                    </DockPanel>

                    <!-- Swiftplay: which of your two champions Apply sets up -->
                    <StackPanel Visibility="{Binding SwiftplaySlots, Converter={StaticResource HasContent}}">
                        <TextBlock Style="{StaticResource SectionHeader}" Text="SWIFTPLAY · SET UP" />
                        <ItemsControl ItemsSource="{Binding SwiftplaySlots}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type local:SlotOption}">
                                    <RadioButton Style="{StaticResource ChipButton}" GroupName="SwiftplaySlot" Content="{Binding Label}" Margin="0,0,6,6"
                                                 IsChecked="{Binding IsSelected, Mode=OneWay}" Checked="OnSwiftplaySlotChecked" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <!-- ===== Ban phase: who to ban, what your team needs, picks that fix it ===== -->
                    <StackPanel Visibility="{Binding IsBanPhase, Converter={StaticResource BoolToVisibility}}">
                        <DockPanel Margin="0,12,0,6">
                            <TextBlock DockPanel.Dock="Right" Text="they beat your champion" Foreground="{StaticResource MutedBrush}" FontSize="11" VerticalAlignment="Bottom" />
                            <TextBlock Text="BAN ONE OF THESE" Foreground="{StaticResource AccentBrush}" FontSize="10" FontWeight="Bold" VerticalAlignment="Bottom" />
                        </DockPanel>
                        <ItemsControl ItemsSource="{Binding Bans}" Margin="-3,0,-3,0">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><UniformGrid Columns="5" /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type local:BanRow}">
                                    <Border x:Name="Tile" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                            CornerRadius="8" Padding="2,8,2,6" Margin="3" ToolTip="{Binding Reason}">
                                        <StackPanel HorizontalAlignment="Center">
                                            <Image Source="{Binding IconUrl}" Width="44" Height="44" HorizontalAlignment="Center" />
                                            <TextBlock x:Name="Name" Text="{Binding Name}" FontSize="11" TextAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,4,0,0" />
                                            <TextBlock Text="{Binding Stat}" FontSize="11" Foreground="#FFE8817E" TextAlignment="Center" />
                                            <TextBlock Text="{Binding StatLabel}" FontSize="9" Foreground="{StaticResource MutedBrush}" TextAlignment="Center"
                                                       Visibility="{Binding StatLabel, Converter={StaticResource HasContent}}" />
                                        </StackPanel>
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding Best}" Value="True">
                                            <Setter TargetName="Tile" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                            <Setter TargetName="Tile" Property="BorderThickness" Value="2" />
                                            <Setter TargetName="Tile" Property="Background" Value="#FF1E2129" />
                                            <Setter TargetName="Name" Property="FontWeight" Value="SemiBold" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="{Binding BanCaption}" Foreground="{StaticResource MutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0" />
                    </StackPanel>

                    <!-- Your team's gaps, the enemy so far, and picks that fill the gap (draft; also before you lock in) -->
                    <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12,10"
                            Margin="0,12,0,0" Visibility="{Binding ShowTeamCard, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel>
                            <TextBlock Text="{Binding TeamHeader}" Foreground="{StaticResource AccentBrush}" FontSize="10" FontWeight="Bold" />
                            <DockPanel Margin="0,8,0,0" Visibility="{Binding TeamSplit, Converter={StaticResource HasContent}}">
                                <TextBlock DockPanel.Dock="Left" Text="Damage so far" Foreground="{StaticResource MutedBrush}" FontSize="11" Width="90" VerticalAlignment="Center" />
                                <TextBlock DockPanel.Dock="Right" Text="{Binding TeamSplit}" FontSize="11" Margin="8,0,0,0" VerticalAlignment="Center" />
                                <Grid Height="6" VerticalAlignment="Center">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="{Binding TeamAdShare}" />
                                        <ColumnDefinition Width="{Binding TeamApShare}" />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Background="{StaticResource AdBrush}" CornerRadius="3,0,0,3" />
                                    <Border Grid.Column="1" Background="{StaticResource ApBrush}" CornerRadius="0,3,3,0" />
                                </Grid>
                            </DockPanel>
                            <ItemsControl ItemsSource="{Binding TeamWarnings}" Margin="0,8,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel Margin="0,0,0,4">
                                            <TextBlock DockPanel.Dock="Left" Text="!" Foreground="{StaticResource GoldBrush}" FontWeight="Bold" Margin="2,0,8,0" />
                                            <TextBlock Text="{Binding}" FontSize="12" TextWrapping="Wrap" Foreground="#FFB9C1CA" />
                                        </DockPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="{Binding EnemySummary}" Foreground="{StaticResource MutedBrush}" FontSize="11" TextWrapping="Wrap"
                                       Visibility="{Binding EnemySummary, Converter={StaticResource HasContent}}" />
                        </StackPanel>
                    </Border>
                    <StackPanel Visibility="{Binding FillPicks, Converter={StaticResource HasContent}}">
                        <TextBlock Style="{StaticResource SectionHeader}" Text="{Binding FillHeader}" />
                        <ItemsControl ItemsSource="{Binding FillPicks}" ItemTemplate="{StaticResource CounterRowTemplate}" />
                    </StackPanel>
                    <TextBlock Text="{Binding DraftNote}" Foreground="{StaticResource MutedBrush}" FontSize="10" TextWrapping="Wrap" Margin="0,4,0,0"
                               Visibility="{Binding DraftNote, Converter={StaticResource HasContent}}" />

                    <!-- In the ban phase the loadout waits, folded -->
                    <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Margin="0,12,0,0"
                            Visibility="{Binding IsBanPhase, Converter={StaticResource BoolToVisibility}}">
                        <ToggleButton Style="{StaticResource FoldToggle}" IsChecked="{Binding LoadoutOpen}" Padding="12,9" AutomationProperties.Name="Runes, spells and playstyle">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Right" Text="after you lock in" Foreground="{StaticResource MutedBrush}" FontSize="11" />
                                <TextBlock Text="Runes, spells and playstyle" Foreground="{StaticResource MutedBrush}" FontSize="12" />
                            </DockPanel>
                        </ToggleButton>
                    </Border>

                    <!-- ===== Pick and lock in: the matchup, what Apply sets, and what's good to know ===== -->
                    <StackPanel Visibility="{Binding ShowLoadout, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel Margin="0,12,0,0" Visibility="{Binding HasLane, Converter={StaticResource BoolToVisibility}}">
                            <DockPanel>
                                <Image DockPanel.Dock="Left" Source="{Binding OpponentIconUrl, TargetNullValue={x:Null}}" Width="28" Height="28" Margin="0,0,8,0"
                                       Visibility="{Binding OpponentIconUrl, Converter={StaticResource HasContent}}" />
                                <TextBlock Text="{Binding OpponentText}" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="Wrap" />
                            </DockPanel>
                            <TextBlock Text="{Binding MatchupText}" Foreground="{StaticResource MutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,3,0,0"
                                       Visibility="{Binding MatchupText, Converter={StaticResource HasContent}}" />
                        </StackPanel>

                        <TextBlock Style="{StaticResource SectionHeader}" Text="APPLY WILL SET" />
                        <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8">
                            <StackPanel>
                                <!-- Rune page: opens to the full page and where it comes from -->
                                <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="12,9">
                                    <StackPanel>
                                        <DockPanel>
                                            <Border DockPanel.Dock="Left" Width="16" Height="16" CornerRadius="3" Background="{StaticResource AccentBrush}" Margin="0,0,10,0" VerticalAlignment="Center">
                                                <TextBlock Text="&#x2713;" FontSize="11" FontWeight="Bold" Foreground="{StaticResource PanelBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <ToggleButton Style="{StaticResource FoldToggle}" IsChecked="{Binding RunesOpen}" AutomationProperties.Name="Rune page">
                                                <DockPanel>
                                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Image Source="{Binding KeystoneIconUrl, TargetNullValue={x:Null}}" Width="24" Height="24" />
                                                        <Image Source="{Binding SecondaryIconUrl, TargetNullValue={x:Null}}" Width="20" Height="20" Margin="3,0,0,0" />
                                                    </StackPanel>
                                                    <StackPanel>
                                                        <TextBlock Text="Rune page" FontSize="13" FontWeight="SemiBold" />
                                                        <TextBlock Text="{Binding RuneSummary}" Foreground="{StaticResource MutedBrush}" FontSize="11" TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>
                                                </DockPanel>
                                            </ToggleButton>
                                        </DockPanel>
                                        <StackPanel Margin="0,10,0,0" Visibility="{Binding RunesOpen, Converter={StaticResource BoolToVisibility}}">
                                            <TextBlock Text="League Classic uses its old masteries and runes, which the client doesn't let apps change, so Apply leaves them alone. The starter mastery page suits most champions."
                                                       Foreground="{StaticResource MutedBrush}" FontSize="11" TextWrapping="Wrap"
                                                       Visibility="{Binding RunesNotSupported, Converter={StaticResource BoolToVisibility}}" />
                                            <StackPanel Visibility="{Binding ShowRunes, Converter={StaticResource BoolToVisibility}}">
                                                <DockPanel Margin="0,0,0,8">
                                                    <StackPanel Orientation="Horizontal">
                                                        <RadioButton Style="{StaticResource ChipButton}" GroupName="RuneSource" Content="op.gg" Margin="0,0,6,0"
                                                                     IsChecked="{Binding Settings.UseStatsSite}"
                                                                     ToolTip="Most played page on op.gg that fits your playstyle. Falls back to LeagueClanker's own page." />
                                                        <RadioButton Style="{StaticResource ChipButton}" GroupName="RuneSource" Content="Own rules"
                                                                     IsChecked="{Binding Settings.UseOwnRules}"
                                                                     ToolTip="LeagueClanker's own page for your playstyle, adjusted to the enemy picks." />
                                                    </StackPanel>
                                                </DockPanel>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding PrimaryName}" Foreground="{StaticResource AccentBrush}" FontSize="10" FontWeight="Bold" Margin="0,0,0,2" />
                                                        <ItemsControl ItemsSource="{Binding PrimaryRunes}" ItemTemplate="{StaticResource RuneRowTemplate}" />
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                                        <TextBlock Text="{Binding SecondaryName}" Foreground="{StaticResource AccentBrush}" FontSize="10" FontWeight="Bold" Margin="0,0,0,2" />
                                                        <ItemsControl ItemsSource="{Binding SecondaryRunes}" ItemTemplate="{StaticResource RuneRowTemplate}" />
                                                        <TextBlock Text="SHARDS" Foreground="{StaticResource AccentBrush}" FontSize="10" FontWeight="Bold" Margin="0,6,0,2" />
                                                        <ItemsControl ItemsSource="{Binding Shards}" ItemTemplate="{StaticResource RuneRowTemplate}" />
                                                    </StackPanel>
                                                </Grid>
                                                <TextBlock Text="{Binding SourceLine}" Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="0,6,0,0" />
                                                <ItemsControl ItemsSource="{Binding Reasons}" Margin="0,4,0,0">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <TextBlock Text="{Binding}" FontSize="11" TextWrapping="Wrap" Foreground="#FFB9C1CA" Margin="0,0,0,2" />
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <!-- Summoner spells -->
                                <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="12,9"
                                        Visibility="{Binding SpellRows, Converter={StaticResource HasContent}}">
                                    <DockPanel>
                                        <CheckBox DockPanel.Dock="Left" Style="{StaticResource SettingCheck}" IsChecked="{Binding Settings.ApplySpells}" Margin="0,2,2,0"
                                                  VerticalAlignment="Center" AutomationProperties.Name="Apply summoner spells" ToolTip="Apply also sets your summoner spells" />
                                        <ItemsControl DockPanel.Dock="Right" ItemsSource="{Binding SpellRows}" VerticalAlignment="Center">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="{x:Type local:RuneRow}">
                                                    <Image Source="{Binding IconUrl}" Width="22" Height="22" Margin="3,0,0,0" ToolTip="{Binding Name}" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <StackPanel>
                                            <TextBlock Text="Summoner spells" FontSize="13" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding SpellLine}" Foreground="{StaticResource MutedBrush}" FontSize="11" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </DockPanel>
                                </Border>

                                <!-- Item set -->
                                <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="12,9">
                                    <DockPanel>
                                        <CheckBox DockPanel.Dock="Left" Style="{StaticResource SettingCheck}" IsChecked="{Binding Settings.ApplyItemSet}" Margin="0,2,2,0"
                                                  VerticalAlignment="Center" AutomationProperties.Name="Apply item set" ToolTip="Apply also adds an item set to the in-game shop" />
                                        <StackPanel>
                                            <TextBlock Text="Item set" FontSize="13" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding ItemSetText}" Foreground="{StaticResource MutedBrush}" FontSize="11" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </DockPanel>
                                </Border>

                                <!-- Playstyle: opens to the choices; it also picks your item build once the game starts -->
                                <Border Padding="12,9">
                                    <StackPanel>
                                        <DockPanel>
                                            <Border DockPanel.Dock="Left" Width="16" Height="16" CornerRadius="3" Background="{StaticResource AccentBrush}" Margin="0,0,10,0" VerticalAlignment="Center">
                                                <TextBlock Text="&#x2713;" FontSize="11" FontWeight="Bold" Foreground="{StaticResource PanelBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <ToggleButton Style="{StaticResource FoldToggle}" IsChecked="{Binding PlaystyleOpen}" AutomationProperties.Name="Playstyle">
                                                <StackPanel>
                                                    <TextBlock Text="Playstyle" FontSize="13" FontWeight="SemiBold" />
                                                    <TextBlock Text="{Binding PlaystyleText}" Foreground="{StaticResource MutedBrush}" FontSize="11" />
                                                </StackPanel>
                                            </ToggleButton>
                                        </DockPanel>
                                        <StackPanel Margin="0,10,0,0" Visibility="{Binding PlaystyleOpen, Converter={StaticResource BoolToVisibility}}">
                                            <ItemsControl ItemsSource="{Binding Playstyles}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate DataType="{x:Type local:PlaystyleOption}">
                                                        <RadioButton Style="{StaticResource ChipButton}" GroupName="Playstyle" Content="{Binding Label}" Margin="0,0,6,6"
                                                                     IsChecked="{Binding IsSelected, Mode=OneWay}" Checked="OnPlaystyleChecked" />
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <TextBlock Text="This also picks your item build once the game starts." Foreground="{StaticResource MutedBrush}" FontSize="10" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>

                        <UniformGrid Columns="2" Margin="0,10,0,0">
                            <Button Style="{StaticResource PrimaryButton}" Content="{Binding ApplyLabel}" Margin="0,0,4,0"
                                    IsEnabled="{Binding CanApply}" Click="OnApplyRunes" AutomationProperties.Name="Apply" />
                            <ToggleButton Content="Apply when I lock in" IsChecked="{Binding Settings.AutoApply}" Margin="4,0,0,0" Cursor="Hand"
                                          ToolTip="Apply automatically when you lock in" AutomationProperties.Name="Apply when I lock in">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="Bg" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="10,7" Background="Transparent">
                                            <TextBlock x:Name="Label" Text="{TemplateBinding Content}" FontSize="12" Foreground="{StaticResource TextBrush}" HorizontalAlignment="Center" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="Bg" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                                <Setter TargetName="Bg" Property="Background" Value="#FF1C1A14" />
                                                <Setter TargetName="Label" Property="Foreground" Value="{StaticResource AccentBrush}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                        </UniformGrid>
                        <TextBlock Text="{Binding ApplyStatus}" Foreground="{StaticResource MutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0"
                                   Visibility="{Binding ApplyStatus, Converter={StaticResource HasContent}}" />

                        <!-- Good to know: skill order, your notes on the opponent, the guessed enemy roles -->
                        <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,12,0,0">
                            <StackPanel>
                                <TextBlock Text="GOOD TO KNOW" Foreground="{StaticResource AccentBrush}" FontSize="10" FontWeight="Bold" />
                                <StackPanel Margin="0,8,0,0" Visibility="{Binding SkillOrder, Converter={StaticResource HasContent}}">
                                    <TextBlock FontSize="12" Foreground="#FFB9C1CA" TextWrapping="Wrap">
                                        <Run Text="{Binding SkillOrder, Mode=OneWay}" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" /><Run Text=". " /><Run Text="{Binding SkillLevels, Mode=OneWay}" />
                                    </TextBlock>
                                </StackPanel>
                                <StackPanel Margin="0,8,0,0" Visibility="{Binding HasOpponent, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Text="{Binding NoteLabel}" Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="0,0,0,3" />
                                    <TextBox Style="{StaticResource SearchBox}" Text="{Binding OpponentNote, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True"
                                             TextWrapping="Wrap" MinHeight="30" MaxHeight="90" VerticalScrollBarVisibility="Auto" FontSize="11"
                                             ToolTip="Saved as you type. Shown whenever you face this champion again, also in game."
                                             AutomationProperties.Name="Matchup notes" />
                                </StackPanel>
                                <StackPanel Margin="0,8,0,0" Visibility="{Binding ShowTeamNotes, Converter={StaticResource BoolToVisibility}}">
                                    <ItemsControl ItemsSource="{Binding TeamWarnings}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <DockPanel Margin="0,0,0,4">
                                                    <TextBlock DockPanel.Dock="Left" Text="!" Foreground="{StaticResource GoldBrush}" FontWeight="Bold" Margin="2,0,8,0" />
                                                    <TextBlock Text="{Binding}" FontSize="12" TextWrapping="Wrap" Foreground="#FFB9C1CA" />
                                                </DockPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock Text="{Binding EnemySummary}" Foreground="#FFB9C1CA" FontSize="12" TextWrapping="Wrap"
                                               Visibility="{Binding EnemySummary, Converter={StaticResource HasContent}}" />
                                </StackPanel>
                                <TextBlock Text="{Binding EnemyRoles}" Foreground="#FFB9C1CA" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0"
                                           Visibility="{Binding EnemyRoles, Converter={StaticResource HasContent}}" />
                                <TextBlock Text="{Binding LaneNote}" Foreground="{StaticResource MutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0"
                                           Visibility="{Binding LaneNote, Converter={StaticResource HasContent}}" />
                            </StackPanel>
                        </Border>

                        <!-- Before you lock in: champions that beat your lane opponent, folded to one line -->
                        <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Margin="0,10,0,0"
                                Visibility="{Binding CounterPicks, Converter={StaticResource HasContent}}">
                            <StackPanel>
                                <ToggleButton Style="{StaticResource FoldToggle}" IsChecked="{Binding CountersOpen}" Padding="12,9" AutomationProperties.Name="Good picks">
                                    <TextBlock Text="{Binding CounterSummary}" Foreground="{StaticResource MutedBrush}" FontSize="12" TextTrimming="CharacterEllipsis" />
                                </ToggleButton>
                                <StackPanel Margin="10,0,10,10" Visibility="{Binding CountersOpen, Converter={StaticResource BoolToVisibility}}">
                                    <ItemsControl ItemsSource="{Binding CounterPicks}" ItemTemplate="{StaticResource CounterRowTemplate}" />
                                    <TextBlock Text="Your win rate with each champion against them on op.gg, all ranks." Foreground="{StaticResource MutedBrush}" FontSize="10" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <!-- ===== Compact mode: the next item and what to buy, with your six slots in a strip ===== -->
            <StackPanel Margin="12,0,12,6" Visibility="{Binding ShowCompactLive, Converter={StaticResource BoolToVisibility}}">
                <!-- An augment offer on screen matters more than the next item, so it goes first. -->
                <Border Background="{StaticResource CardBrush}" CornerRadius="4" Padding="8,6" Margin="0,0,0,8"
                        Visibility="{Binding Augments.OfferOnScreen, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel>
                        <TextBlock Text="AUGMENT OFFER" Foreground="{StaticResource AccentBrush}" FontSize="10" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding Augments.AdviceText}" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,3,0,0"
                                   Visibility="{Binding Augments.AdviceText, Converter={StaticResource HasContent}}" />
                        <TextBlock Text="{Binding Augments.RerollText}" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"
                                   Visibility="{Binding Augments.RerollText, Converter={StaticResource HasContent}}" />
                        <TextBlock Text="Ranking the cards..." Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,3,0,0"
                                   Visibility="{Binding Augments.IsRanking, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>
                </Border>
                <DockPanel>
                    <Border DockPanel.Dock="Left" BorderBrush="{StaticResource AccentBrush}" BorderThickness="2" CornerRadius="7" Padding="1" Margin="0,0,10,0">
                        <Image Source="{Binding NextItem.IconUrl, TargetNullValue={x:Null}}" Width="40" Height="40" />
                    </Border>
                    <Ellipse DockPanel.Dock="Right" Width="8" Height="8" Fill="{StaticResource AccentBrush}" VerticalAlignment="Center" Margin="8,0,0,0"
                             ToolTip="{Binding PivotSummary}" Visibility="{Binding HasPivot, Converter={StaticResource BoolToVisibility}}" />
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock>
                            <Run Text="{Binding NextItem.Name, Mode=OneWay}" FontSize="14" FontWeight="SemiBold" /><Run Text="  " /><Run Text="{Binding NextItemLeft, Mode=OneWay}" FontSize="11" Foreground="{StaticResource MutedBrush}" />
                        </TextBlock>
                        <TextBlock Text="{Binding BuyText}" FontSize="12" Foreground="#FFB9C1CA" TextWrapping="Wrap" MaxHeight="34" TextTrimming="CharacterEllipsis"
                                   Visibility="{Binding BuyText, Converter={StaticResource HasContent}}" />
                    </StackPanel>
                </DockPanel>
                <TextBlock Text="{Binding StartText}" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0" Foreground="{StaticResource AccentBrush}"
                           Visibility="{Binding StartText, Converter={StaticResource HasContent}}" />
                <DockPanel Margin="2,8,0,0">
                    <TextBlock DockPanel.Dock="Right" Text="{Binding MatchupLine}" Foreground="{StaticResource MutedBrush}" FontSize="11" TextTrimming="CharacterEllipsis"
                               MaxWidth="160" VerticalAlignment="Center" ToolTip="{Binding MatchupLine}" />
                    <ItemsControl ItemsSource="{Binding Slots}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type local:SlotRow}">
                                <Grid Width="24" Height="24" Margin="0,0,5,0" ToolTip="{Binding Name}">
                                    <Rectangle x:Name="Empty" RadiusX="4" RadiusY="4" Stroke="{StaticResource BorderBrush}" StrokeDashArray="3 2" Visibility="Collapsed" />
                                    <Border x:Name="Ring" BorderBrush="{StaticResource AccentBrush}" BorderThickness="0" CornerRadius="5">
                                        <Image x:Name="Icon" Source="{Binding IconUrl, TargetNullValue={x:Null}}" />
                                    </Border>
                                </Grid>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding Kind}" Value="Next">
                                        <Setter TargetName="Ring" Property="BorderThickness" Value="2" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Kind}" Value="Planned">
                                        <Setter TargetName="Icon" Property="Opacity" Value="0.4" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Kind}" Value="Switch">
                                        <Setter TargetName="Icon" Property="Opacity" Value="0.4" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Kind}" Value="Empty">
                                        <Setter TargetName="Empty" Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </DockPanel>
            </StackPanel>

            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="12,0,12,0"
                          Visibility="{Binding ShowFullLive, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                    <DockPanel Margin="0,6,0,8">
                        <Border DockPanel.Dock="Left" Width="44" Height="44" CornerRadius="8" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                Margin="0,0,10,0" VerticalAlignment="Center" ClipToBounds="True">
                            <Image Source="{Binding ChampionIconUrl, TargetNullValue={x:Null}}" Stretch="UniformToFill" />
                        </Border>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <RadioButton Style="{StaticResource TabButton}" Content="Build" GroupName="Tabs" IsChecked="{Binding IsBuildTab}" />
                            <RadioButton Style="{StaticResource TabButton}" Content="Augments" GroupName="Tabs" IsChecked="{Binding IsAugmentsTab}"
                                         Visibility="{Binding HasAugments, Converter={StaticResource BoolToVisibility}}" />
                            <RadioButton Style="{StaticResource TabButton}" Content="Players" GroupName="Tabs" IsChecked="{Binding IsPlayersTab}" Margin="0" />
                        </StackPanel>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,10,0">
                            <TextBlock Text="{Binding ChampionLine}" FontSize="17" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                            <!-- How you play this champion. Changing it rebuilds the item list. -->
                            <WrapPanel>
                                <TextBlock Text="Playing as" Foreground="{StaticResource MutedBrush}" FontSize="11" />
                                <Button Style="{StaticResource LinkButton}" Content="{Binding PlaystyleLabel}" Margin="4,0,0,0" Click="OnPlaystyleMenu"
                                        ToolTip="Change how you play this champion, e.g. AP instead of AD" AutomationProperties.Name="Change playstyle" />
                                <TextBlock Text="{Binding CardsText}" Foreground="{StaticResource MutedBrush}" FontSize="11" />
                            </WrapPanel>
                        </StackPanel>
                    </DockPanel>
                    <TextBlock Text="{Binding MatchupLine}" Foreground="{StaticResource MutedBrush}" FontSize="11" TextTrimming="CharacterEllipsis" Margin="0,0,0,6"
                               Visibility="{Binding MatchupLine, Converter={StaticResource HasContent}}" ToolTip="Your lane matchup on op.gg, all ranks" />
                    <TextBlock Text="{Binding MatchupNote}" Foreground="{StaticResource AccentBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,-2,0,6"
                               Visibility="{Binding MatchupNote, Converter={StaticResource HasContent}}" />

                    <!-- ===== Build tab ===== -->
                    <StackPanel Visibility="{Binding IsBuildTab, Converter={StaticResource BoolToVisibility}}">

                        <!-- Start of the game (Summoner's Rift, first two minutes) -->
                        <Border Background="{StaticResource CardBrush}" CornerRadius="6" Padding="10,7" Margin="0,4,0,0"
                                Visibility="{Binding StartText, Converter={StaticResource HasContent}}">
                            <StackPanel>
                                <TextBlock Text="START OF THE GAME" Foreground="{StaticResource AccentBrush}" FontSize="10" FontWeight="Bold" />
                                <TextBlock Text="{Binding StartText}" FontSize="12" TextWrapping="Wrap" Margin="0,2,0,0" />
                            </StackPanel>
                        </Border>

                        <!-- Your six slots: what you own, then the plan in buy order, boots included -->
                        <DockPanel Margin="0,10,0,6">
                            <TextBlock DockPanel.Dock="Right" Text="{Binding SlotsSummary}" Foreground="{StaticResource MutedBrush}" FontSize="11" VerticalAlignment="Bottom" />
                            <TextBlock Text="{Binding SlotsHeader}" Foreground="{StaticResource AccentBrush}" FontSize="10" FontWeight="Bold" VerticalAlignment="Bottom" />
                        </DockPanel>
                        <ItemsControl ItemsSource="{Binding Slots}" Margin="-4,0,-4,0">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><UniformGrid Columns="3" /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type local:SlotRow}">
                                    <Grid Margin="4" MinHeight="122" ToolTip="{Binding Name}">
                                        <Border x:Name="Box" Background="{StaticResource CardBrush}" CornerRadius="8" />
                                        <Rectangle x:Name="Outline" RadiusX="8" RadiusY="8" Stroke="{StaticResource BorderBrush}" StrokeThickness="1" />
                                        <StackPanel Margin="6,10,6,8">
                                            <Grid Height="48" HorizontalAlignment="Center">
                                                <Image x:Name="Icon" Source="{Binding IconUrl, TargetNullValue={x:Null}}" Width="48" Height="48" />
                                                <StackPanel x:Name="SwitchIcons" Orientation="Horizontal" VerticalAlignment="Center" Visibility="Collapsed">
                                                    <Image Source="{Binding OldIconUrl, TargetNullValue={x:Null}}" Width="28" Height="28" Opacity="0.4" />
                                                    <TextBlock Text="&#x2192;" Foreground="{StaticResource AccentBrush}" FontWeight="Bold" Margin="3,0" VerticalAlignment="Center" />
                                                    <Border BorderBrush="{StaticResource AccentBrush}" BorderThickness="1" CornerRadius="5">
                                                        <Image Source="{Binding IconUrl, TargetNullValue={x:Null}}" Width="38" Height="38" />
                                                    </Border>
                                                </StackPanel>
                                            </Grid>
                                            <TextBlock x:Name="NameText" Text="{Binding Name}" FontSize="11" TextAlignment="Center" TextWrapping="Wrap"
                                                       MaxHeight="30" TextTrimming="CharacterEllipsis" Margin="0,5,0,0" />
                                            <TextBlock x:Name="OldNameText" Text="{Binding OldName}" FontSize="10" TextAlignment="Center" Foreground="{StaticResource MutedBrush}"
                                                       TextDecorations="Strikethrough" Visibility="Collapsed" />
                                            <Border BorderBrush="#80C8AA6E" BorderThickness="1" CornerRadius="3" Padding="4,0" Margin="0,4,0,0" HorizontalAlignment="Center"
                                                    Visibility="{Binding Tag, Converter={StaticResource HasContent}}">
                                                <TextBlock Text="{Binding Tag}" Foreground="{StaticResource AccentBrush}" FontSize="10" TextTrimming="CharacterEllipsis" />
                                            </Border>
                                            <Grid x:Name="Progress" Height="4" Margin="0,6,0,0" Visibility="Collapsed">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="{Binding ProgressDone}" />
                                                    <ColumnDefinition Width="{Binding ProgressLeft}" />
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.ColumnSpan="2" Background="{StaticResource BorderBrush}" CornerRadius="2" />
                                                <Border Background="{StaticResource AccentBrush}" CornerRadius="2" />
                                            </Grid>
                                            <TextBlock Text="{Binding Price}" Foreground="{StaticResource MutedBrush}" FontSize="10" TextAlignment="Center" Margin="0,4,0,0"
                                                       Visibility="{Binding Price, Converter={StaticResource HasContent}}" />
                                        </StackPanel>
                                        <Border x:Name="Badge" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="6,6,0,0" CornerRadius="8" Padding="6,0"
                                                Background="{StaticResource BorderBrush}">
                                            <TextBlock x:Name="BadgeText" Text="{Binding Number}" FontSize="10" FontWeight="Bold" />
                                        </Border>
                                    </Grid>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding Number}" Value="0">
                                            <Setter TargetName="Badge" Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Kind}" Value="Next">
                                            <Setter TargetName="Box" Property="Background" Value="#FF1E2129" />
                                            <Setter TargetName="Outline" Property="Stroke" Value="{StaticResource AccentBrush}" />
                                            <Setter TargetName="Outline" Property="StrokeThickness" Value="2" />
                                            <Setter TargetName="Badge" Property="Background" Value="{StaticResource AccentBrush}" />
                                            <Setter TargetName="BadgeText" Property="Foreground" Value="{StaticResource PanelBrush}" />
                                            <Setter TargetName="NameText" Property="FontWeight" Value="SemiBold" />
                                            <Setter TargetName="Progress" Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Kind}" Value="Planned">
                                            <Setter TargetName="Box" Property="Background" Value="#FF12171D" />
                                            <Setter TargetName="Outline" Property="StrokeDashArray" Value="4 3" />
                                            <Setter TargetName="Icon" Property="Opacity" Value="0.6" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Kind}" Value="Switch">
                                            <Setter TargetName="Box" Property="Background" Value="#FF1C1A14" />
                                            <Setter TargetName="Outline" Property="Stroke" Value="{StaticResource AccentBrush}" />
                                            <Setter TargetName="Outline" Property="StrokeDashArray" Value="4 3" />
                                            <Setter TargetName="Icon" Property="Visibility" Value="Collapsed" />
                                            <Setter TargetName="SwitchIcons" Property="Visibility" Value="Visible" />
                                            <Setter TargetName="OldNameText" Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Kind}" Value="Empty">
                                            <Setter TargetName="Box" Property="Background" Value="Transparent" />
                                            <Setter TargetName="Outline" Property="StrokeDashArray" Value="4 3" />
                                            <Setter TargetName="NameText" Property="Foreground" Value="{StaticResource MutedBrush}" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- A suggested switch: accept or keep your build -->
                        <Border Visibility="{Binding HasPivot, Converter={StaticResource BoolToVisibility}}"
                                BorderBrush="{StaticResource AccentBrush}" BorderThickness="1" CornerRadius="8"
                                Background="#FF1C1A14" Padding="12,10" Margin="0,10,0,0">
                            <StackPanel>
                                <TextBlock Text="{Binding PivotHeader}" Foreground="{StaticResource AccentBrush}" FontSize="10" FontWeight="Bold" />
                                <TextBlock Text="{Binding PivotTitle}" FontWeight="SemiBold" FontSize="14" TextWrapping="Wrap" Margin="0,4,0,4" />
                                <ItemsControl ItemsSource="{Binding PivotNotes}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}" FontSize="12" TextWrapping="Wrap" Foreground="#FFB9C1CA" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <UniformGrid Columns="2" Margin="0,10,0,0">
                                    <Button Style="{StaticResource PrimaryButton}" Content="{Binding PivotAccept}" Click="OnAcceptPivot" Margin="0,0,4,0"
                                            AutomationProperties.Name="Switch build" />
                                    <Button Style="{StaticResource SecondaryButton}" Content="{Binding PivotDecline}" Click="OnDeclinePivot" Margin="4,0,0,0"
                                            AutomationProperties.Name="Keep mine" />
                                </UniformGrid>
                            </StackPanel>
                        </Border>

                        <!-- After declining (or on small differences), switching stays one click away -->
                        <DockPanel Visibility="{Binding ShowSwitchHint, Converter={StaticResource BoolToVisibility}}" Margin="0,10,0,0">
                            <Button DockPanel.Dock="Right" Style="{StaticResource LinkButton}" Content="Switch anyway" Click="OnSwitchToLatest" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding SwitchHint}" Foreground="{StaticResource MutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,0,8,0" />
                        </DockPanel>

                        <!-- Full build: what your gold buys after a sale, and the items worth selling -->
                        <Border Background="{StaticResource CardBrush}" CornerRadius="6" Padding="10,7" Margin="0,10,0,0"
                                Visibility="{Binding ShowSellAdvice, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel>
                                <TextBlock Text="SELL FOR SOMETHING BETTER" Foreground="{StaticResource AccentBrush}" FontSize="10" FontWeight="Bold" />
                                <TextBlock Text="{Binding BuyText}" FontSize="12" TextWrapping="Wrap" Margin="0,2,0,0" />
                            </StackPanel>
                        </Border>
                        <ItemsControl ItemsSource="{Binding Items}" Margin="0,8,0,0" Visibility="{Binding ShowSwaps, Converter={StaticResource BoolToVisibility}}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type local:ItemRow}">
                                    <Border Background="{StaticResource CardBrush}" CornerRadius="6" Padding="8,4" Margin="0,0,0,4">
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Left" Text="{Binding Rank}" Foreground="{StaticResource AccentBrush}" FontWeight="Bold" VerticalAlignment="Center" Width="18" />
                                            <Image DockPanel.Dock="Left" Source="{Binding IconUrl}" Width="30" Height="30" Margin="0,0,10,0" />
                                            <StackPanel VerticalAlignment="Center">
                                                <DockPanel>
                                                    <TextBlock DockPanel.Dock="Right" Text="{Binding Gold, StringFormat={}{0}g}" Foreground="{StaticResource MutedBrush}" FontSize="11" />
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                </DockPanel>
                                                <TextBlock Text="{Binding ReasonText}" Foreground="{StaticResource AccentBrush}" FontSize="10" TextWrapping="Wrap" />
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <ItemsControl ItemsSource="{Binding Tips}" Margin="0,8,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel Margin="0,0,0,3">
                                        <TextBlock DockPanel.Dock="Left" Text="&#x2022;" Foreground="{StaticResource AccentBrush}" Margin="0,0,6,0" />
                                        <TextBlock Text="{Binding}" FontSize="11" TextWrapping="Wrap" />
                                    </DockPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- The cards you picked and what they do to the build -->
                        <StackPanel Visibility="{Binding CardNotes, Converter={StaticResource HasContent}}">
                            <TextBlock Style="{StaticResource SectionHeader}" Text="YOUR CARDS" />
                            <ItemsControl ItemsSource="{Binding CardNotes}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type local:CardNote}">
                                        <DockPanel Margin="0,0,0,6">
                                            <Border DockPanel.Dock="Left" BorderBrush="{StaticResource GoldBrush}" BorderThickness="1" CornerRadius="4" Padding="7,1"
                                                    Margin="0,0,8,0" VerticalAlignment="Top">
                                                <TextBlock Text="{Binding Name}" Foreground="{StaticResource GoldBrush}" FontSize="11" FontWeight="SemiBold" />
                                            </Border>
                                            <TextBlock Text="{Binding Text}" Foreground="#FFB9C1CA" FontSize="12" TextWrapping="Wrap" />
                                        </DockPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <!-- Enemy damage split -->
                        <DockPanel Margin="0,12,0,4">
                            <TextBlock DockPanel.Dock="Right" Text="{Binding DamageSplit}" FontSize="11" />
                            <TextBlock Text="Enemy damage" Foreground="{StaticResource MutedBrush}" FontSize="11" />
                        </DockPanel>
                        <Grid Height="6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="{Binding AdShare}" />
                                <ColumnDefinition Width="{Binding ApShare}" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Background="{StaticResource AdBrush}" CornerRadius="3,0,0,3" />
                            <Border Grid.Column="1" Background="{StaticResource ApBrush}" CornerRadius="0,3,3,0" />
                        </Grid>

                        <!-- Other ways to go: tankier, more AP, an answer to the enemy -->
                        <StackPanel Visibility="{Binding Alternatives, Converter={StaticResource HasContent}}">
                            <TextBlock Style="{StaticResource SectionHeader}" Text="OR GO ANOTHER WAY" />
                            <ItemsControl ItemsSource="{Binding Alternatives}" Margin="-4,0,-4,0">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><UniformGrid Columns="3" /></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type local:AlternativeRow}">
                                        <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8"
                                                Padding="7" Margin="4" ToolTip="{Binding Gold, StringFormat={}{0}g}">
                                            <DockPanel>
                                                <Image DockPanel.Dock="Left" Source="{Binding IconUrl}" Width="28" Height="28" Margin="0,0,7,0" VerticalAlignment="Center" />
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Direction}" Foreground="{StaticResource MutedBrush}" FontSize="10" />
                                                    <TextBlock Text="{Binding Name}" FontSize="11" TextWrapping="Wrap" />
                                                </StackPanel>
                                            </DockPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <!-- Why this build: folded away, the slots carry the main reasons -->
                        <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Margin="0,12,0,8">
                            <StackPanel>
                                <ToggleButton IsChecked="{Binding WhyOpen}" Cursor="Hand" AutomationProperties.Name="Why this build">
                                    <ToggleButton.Template>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Border Background="Transparent" Padding="0,10,0,8">
                                                <DockPanel>
                                                    <TextBlock x:Name="Chevron" DockPanel.Dock="Right" Text="&#x25BE;" Foreground="{StaticResource MutedBrush}" Margin="8,0,0,0" />
                                                    <TextBlock DockPanel.Dock="Right" Text="{Binding WhyHint}" Foreground="{StaticResource MutedBrush}" FontSize="11" />
                                                    <TextBlock Text="WHY THIS BUILD" Foreground="{StaticResource AccentBrush}" FontSize="10" FontWeight="Bold" VerticalAlignment="Center" />
                                                </DockPanel>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsChecked" Value="True">
                                                    <Setter TargetName="Chevron" Property="Text" Value="&#x25B4;" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </ToggleButton.Template>
                                </ToggleButton>
                                <StackPanel Visibility="{Binding WhyOpen, Converter={StaticResource BoolToVisibility}}">
                                    <ItemsControl ItemsSource="{Binding MetaBars}" Margin="0,0,0,6">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type local:MetaBar}">
                                                <Grid Margin="0,0,0,5">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="70" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="130" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock x:Name="BarName" Text="{Binding Name}" FontSize="11" Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis" />
                                                    <Grid Grid.Column="1" Height="6" VerticalAlignment="Center">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="{Binding Filled}" />
                                                            <ColumnDefinition Width="{Binding Empty}" />
                                                        </Grid.ColumnDefinitions>
                                                        <Border Grid.ColumnSpan="2" Background="{StaticResource BorderBrush}" CornerRadius="3" />
                                                        <Border x:Name="BarFill" Background="#FF5A6673" CornerRadius="3" />
                                                    </Grid>
                                                    <TextBlock Grid.Column="2" Text="{Binding Text}" FontSize="11" Foreground="{StaticResource MutedBrush}" TextAlignment="Right" />
                                                </Grid>
                                                <DataTemplate.Triggers>
                                                    <DataTrigger Binding="{Binding Chosen}" Value="True">
                                                        <Setter TargetName="BarFill" Property="Background" Value="{StaticResource AccentBrush}" />
                                                        <Setter TargetName="BarName" Property="Foreground" Value="{StaticResource TextBrush}" />
                                                    </DataTrigger>
                                                </DataTemplate.Triggers>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock Text="{Binding BuildSource}" Foreground="#FFB9C1CA" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,8"
                                               Visibility="{Binding BuildSource, Converter={StaticResource HasContent}}" />
                                    <ItemsControl ItemsSource="{Binding Advice}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding}" TextWrapping="Wrap" FontSize="12" Foreground="#FFB9C1CA" Margin="0,0,0,6" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ===== Augments tab (ARAM: Mayhem) ===== -->
                    <Grid Visibility="{Binding IsAugmentsTab, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel x:Name="AugmentsPanel" DataContext="{Binding Augments}" Margin="0,0,0,8">
                        <TextBlock Text="{Binding Status}" Foreground="{StaticResource MutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,12,0,0" />

                        <TextBlock Style="{StaticResource SectionHeader}" Text="YOUR CARDS" />
                        <TextBlock Text="None yet" Foreground="{StaticResource MutedBrush}" FontSize="11"
                                   Visibility="{Binding Picked, Converter={StaticResource HasContent}, ConverterParameter=invert}" />
                        <ItemsControl ItemsSource="{Binding Picked}">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type local:AugmentRow}">
                                    <Border Background="{StaticResource CardBrush}" CornerRadius="4" Padding="8,3,4,3" Margin="0,0,6,6" ToolTip="{Binding Description}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Style="{StaticResource TierName}" Text="{Binding Name}" FontSize="12" />
                                            <Button Style="{StaticResource RemoveButton}" Content="✕" ToolTip="Remove" Click="OnRemovePicked"
                                                    AutomationProperties.Name="{Binding Name, StringFormat=Remove picked {0}}" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Style="{StaticResource SectionHeader}" Text="OFFERED NOW" />
                        <!-- Until the cards are ranked (or typed in), they show as chips you can remove -->
                        <ItemsControl ItemsSource="{Binding Offer}" Visibility="{Binding Cards, Converter={StaticResource HasContent}, ConverterParameter=invert}">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type local:AugmentRow}">
                                    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="8,3,4,3" Margin="0,0,6,6" ToolTip="{Binding Description}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Style="{StaticResource TierName}" Text="{Binding Name}" FontSize="12" />
                                            <Button Style="{StaticResource RemoveButton}" Content="✕" ToolTip="Remove" Click="OnRemoveOffer"
                                                    AutomationProperties.Name="{Binding Name, StringFormat=Remove offered {0}}" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- The offer as three cards, in the order they sit on screen; click one for its reasons -->
                        <ItemsControl ItemsSource="{Binding Cards}" Margin="-4,0,-4,0">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><UniformGrid Columns="3" /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type local:AugmentOptionRow}">
                                    <Grid Margin="4">
                                        <Button Click="OnSelectCard" Cursor="Hand" ToolTip="{Binding Scores}" AutomationProperties.Name="{Binding Name}">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="Card" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                                            CornerRadius="10" Padding="6,10,6,8" MinHeight="168">
                                                        <ContentPresenter />
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                            <Setter TargetName="Card" Property="BorderBrush" Value="{StaticResource GoldBrush}" />
                                                            <Setter TargetName="Card" Property="BorderThickness" Value="2" />
                                                            <Setter TargetName="Card" Property="Background" Value="#FF1E1C14" />
                                                        </DataTrigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                            <StackPanel HorizontalAlignment="Center">
                                                <TextBlock Style="{StaticResource TierName}" Text="{Binding Tier}" FontSize="9" FontWeight="Normal" HorizontalAlignment="Center" />
                                                <TextBlock Style="{StaticResource TierName}" Text="{Binding Name}" FontSize="12" TextAlignment="Center" TextWrapping="Wrap"
                                                           HorizontalAlignment="Center" MinHeight="32" Margin="0,4,0,6" />
                                                <ItemsControl ItemsSource="{Binding Segments}" HorizontalAlignment="Center">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border x:Name="Segment" Width="13" Height="6" CornerRadius="2" Margin="1.5,0" Background="{StaticResource BorderBrush}" />
                                                            <DataTemplate.Triggers>
                                                                <DataTrigger Binding="{Binding}" Value="True">
                                                                    <Setter TargetName="Segment" Property="Background" Value="{StaticResource GoldBrush}" />
                                                                </DataTrigger>
                                                            </DataTemplate.Triggers>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                                <TextBlock Text="{Binding FitWord}" FontSize="12" Foreground="#FFB9C1CA" HorizontalAlignment="Center" Margin="0,5,0,5" />
                                                <Border x:Name="Badge" CornerRadius="9" Padding="7,0" HorizontalAlignment="Center" BorderThickness="1"
                                                        BorderBrush="{StaticResource MutedBrush}" Visibility="{Binding Badge, Converter={StaticResource HasContent}}">
                                                    <TextBlock x:Name="BadgeText" Text="{Binding Badge}" FontSize="9" FontWeight="Bold" Foreground="{StaticResource MutedBrush}" />
                                                </Border>
                                                <TextBlock Text="{Binding RerollNote}" FontSize="10" Foreground="{StaticResource MutedBrush}" TextAlignment="Center" TextWrapping="Wrap"
                                                           Margin="0,5,0,0" Visibility="{Binding RerollNote, Converter={StaticResource HasContent}}" />
                                            </StackPanel>
                                        </Button>
                                        <Button Style="{StaticResource RemoveButton}" Content="✕" ToolTip="Remove a misread card" Click="OnRemoveOffer"
                                                HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,3,3,0"
                                                AutomationProperties.Name="{Binding Name, StringFormat=Remove offered {0}}" />
                                    </Grid>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding BadgeFilled}" Value="True">
                                            <Setter TargetName="Badge" Property="BorderBrush" Value="#FF5FBF77" />
                                            <Setter TargetName="BadgeText" Property="Foreground" Value="#FF5FBF77" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="Simulating future picks..." Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,4,0,0"
                                   Visibility="{Binding IsRanking, Converter={StaticResource BoolToVisibility}}" />

                        <!-- The selected card: why, what it combos with, and what you did with it -->
                        <Border DataContext="{Binding SelectedCard}" BorderBrush="{StaticResource AccentBrush}" BorderThickness="1" CornerRadius="8"
                                Background="#FF1C1A14" Padding="12,10" Margin="0,10,0,6">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel>
                                <TextBlock Text="{Binding Heading}" Foreground="{StaticResource AccentBrush}" FontSize="10" FontWeight="Bold" />
                                <TextBlock Text="{Binding DataContext.RerollText, ElementName=AugmentsPanel}" TextWrapping="Wrap" FontSize="12" Foreground="#FFB9C1CA" Margin="0,4,0,0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Rank}" Value="1">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <ItemsControl ItemsSource="{Binding Reasons}" Margin="0,6,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}" FontSize="12" TextWrapping="Wrap" Foreground="#FFB9C1CA" Margin="0,0,0,2" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="{Binding Combos}" Foreground="{StaticResource MutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"
                                           Visibility="{Binding Combos, Converter={StaticResource HasContent}}" />
                                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                    <Button Style="{StaticResource PrimaryButton}" Content="I picked this" Click="OnPickOption"
                                            AutomationProperties.Name="{Binding Name, StringFormat=I picked {0}}" />
                                    <Button Style="{StaticResource SmallButton}" Content="Rerolled" Click="OnRerolledOption" Margin="8,0,0,0" VerticalAlignment="Center"
                                            ToolTip="You rerolled it in game: type the card you got instead"
                                            Visibility="{Binding CanReroll, Converter={StaticResource BoolToVisibility}}"
                                            AutomationProperties.Name="{Binding Name, StringFormat=Rerolled {0}}" />
                                    <ToggleButton Content="Golden" Checked="OnGoldenChanged" Unchecked="OnGoldenChanged" Margin="8,0,0,0" VerticalAlignment="Center"
                                                  IsChecked="{Binding IsGolden, Mode=OneWay}" Style="{StaticResource GoldenToggle}"
                                                  ToolTip="This card's reroll button is golden: it rerolls into the next tier"
                                                  Visibility="{Binding CanBeGolden, Converter={StaticResource BoolToVisibility}}"
                                                  AutomationProperties.Name="{Binding Name, StringFormat=Golden {0}}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Search: Enter adds the top match to the offer -->
                        <Grid Margin="0,2,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="1" Style="{StaticResource SmallButton}" Content="Read cards now" Margin="6,0,0,0" Click="OnScanNow"
                                    IsEnabled="{Binding IsAvailable}" ToolTip="Read the offer on your screen right away" />
                            <TextBox x:Name="AugmentSearch" Style="{StaticResource SearchBox}" AutomationProperties.AutomationId="AugmentSearch"
                                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" KeyDown="OnAugmentSearchKeyDown"
                                     IsEnabled="{Binding IsAvailable}" />
                            <TextBlock Text="Type a card name, e.g. crit" IsHitTestVisible="False" Foreground="{StaticResource MutedBrush}"
                                       FontSize="12" Margin="10,0,0,0" VerticalAlignment="Center"
                                       Visibility="{Binding SearchText, Converter={StaticResource HasContent}, ConverterParameter=invert}" />
                        </Grid>
                        <ItemsControl ItemsSource="{Binding Suggestions}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type local:AugmentRow}">
                                    <Border Background="{StaticResource CardBrush}" CornerRadius="4" Padding="8,4" Margin="0,0,0,3" ToolTip="{Binding Description}">
                                        <DockPanel>
                                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                                <Button Style="{StaticResource SmallButton}" Content="Offered" Click="OnOfferSuggestion"
                                                        ToolTip="It's in the offer on screen" AutomationProperties.Name="{Binding Name, StringFormat=Offer {0}}" />
                                                <Button Style="{StaticResource SmallButton}" Content="Picked" Click="OnPickedSuggestion" Margin="4,0,0,0"
                                                        ToolTip="You already have it" AutomationProperties.Name="{Binding Name, StringFormat=Have {0}}" />
                                            </StackPanel>
                                            <TextBlock Text="{Binding Tier}" Foreground="{StaticResource MutedBrush}" FontSize="10" DockPanel.Dock="Right" VerticalAlignment="Center" Margin="0,0,8,0" />
                                            <TextBlock Style="{StaticResource TierName}" Text="{Binding Name}" FontSize="12" />
                                        </DockPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="When you take a card in the game, the app reads it from your HUD, or from your click, and marks it as picked. Strength is how well a card fits your champion, items and cards right now; hover a card for the exact score."
                                   Foreground="{StaticResource MutedBrush}" FontSize="10" TextWrapping="Wrap" Margin="0,6,0,0" />
                        <TextBlock Text="{Binding Attribution}" Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="0,6,0,0" />
                    </StackPanel>
                    </Grid>

                    <!-- ===== Players tab: the stats table, or a card per enemy ===== -->
                    <StackPanel Visibility="{Binding IsPlayersTab, Converter={StaticResource BoolToVisibility}}" Margin="0,0,0,8">
                        <DockPanel Margin="0,10,0,0">
                            <TextBlock DockPanel.Dock="Right" Text="most dangerous first" Foreground="{StaticResource MutedBrush}" FontSize="11" VerticalAlignment="Center" />
                            <StackPanel Orientation="Horizontal">
                                <RadioButton Style="{StaticResource ChipButton}" GroupName="PlayersView" Content="Table" Margin="0,0,6,0" IsChecked="{Binding Settings.PlayersAsTable}" />
                                <RadioButton Style="{StaticResource ChipButton}" GroupName="PlayersView" Content="Cards" IsChecked="{Binding Settings.PlayersAsCards}" />
                            </StackPanel>
                        </DockPanel>

                        <StackPanel Visibility="{Binding Settings.PlayersAsTable, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Style="{StaticResource SectionHeader}" Text="ENEMIES" />
                            <ContentControl Template="{StaticResource PlayerHeader}" />
                            <ItemsControl ItemsSource="{Binding Enemies}" ItemTemplate="{StaticResource PlayerRowTemplate}" />
                            <TextBlock Style="{StaticResource SectionHeader}" Text="YOUR TEAM" />
                            <ContentControl Template="{StaticResource PlayerHeader}" />
                            <ItemsControl ItemsSource="{Binding Team}" ItemTemplate="{StaticResource PlayerRowTemplate}" />
                            <TextBlock Text="The deeper the color, the closer to the highest in the lobby. Your stats come from the game; everyone else's are base stats at their level plus items. Hover a row for details."
                                       Foreground="{StaticResource MutedBrush}" FontSize="10" TextWrapping="Wrap" Margin="0,8,0,0" />
                        </StackPanel>

                        <StackPanel Visibility="{Binding Settings.PlayersAsCards, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Style="{StaticResource SectionHeader}" Text="ENEMIES" />
                            <ItemsControl ItemsSource="{Binding Enemies}" ItemTemplate="{StaticResource ThreatCardTemplate}" />
                            <TextBlock Style="{StaticResource SectionHeader}" Text="YOUR TEAM" />
                            <ItemsControl ItemsSource="{Binding Team}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><UniformGrid Columns="5" /></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type local:PlayerRow}">
                                        <StackPanel HorizontalAlignment="Center" ToolTip="{Binding Note}">
                                            <Border x:Name="Ring" Width="36" Height="36" CornerRadius="18" BorderBrush="{StaticResource BorderBrush}" BorderThickness="2" ClipToBounds="True">
                                                <Image Source="{Binding IconUrl}" />
                                            </Border>
                                            <TextBlock Text="{Binding Name}" FontSize="10" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,3,0,0" />
                                        </StackPanel>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsMe}" Value="True">
                                                <Setter TargetName="Ring" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="Damage: red is AD, blue is AP. Toughness is health plus armor and magic resist, against the lobby."
                                       Foreground="{StaticResource MutedBrush}" FontSize="10" TextWrapping="Wrap" Margin="0,8,0,0" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <!-- ===== Settings: covers the other panels while open ===== -->
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="12,0,12,0" Background="{StaticResource PanelBrush}"
                          Visibility="{Binding ShowSettings, Converter={StaticResource BoolToVisibility}}">
                <StackPanel DataContext="{Binding Settings}" Margin="0,2,0,8">
                    <DockPanel Margin="0,6,0,0">
                        <Button DockPanel.Dock="Right" Style="{StaticResource LinkButton}" Content="Done" Click="OnToggleSettings" VerticalAlignment="Center" />
                        <TextBlock Text="Settings" FontSize="17" FontWeight="SemiBold" />
                    </DockPanel>

                    <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,10,0,0">
                        <StackPanel>
                            <TextBlock Text="STATS SOURCE" Foreground="{StaticResource AccentBrush}" FontSize="10" FontWeight="Bold" />
                            <TextBlock Text="For runes, summoner spells, skill order, starting items and matchups. Own rules work offline."
                                       Foreground="{StaticResource MutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,8" />
                            <StackPanel Orientation="Horizontal">
                                <RadioButton Style="{StaticResource ChipButton}" GroupName="SettingsSource" Content="op.gg" Margin="0,0,6,0" IsChecked="{Binding UseStatsSite}" />
                                <RadioButton Style="{StaticResource ChipButton}" GroupName="SettingsSource" Content="Own rules" IsChecked="{Binding UseOwnRules}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12,10,12,4" Margin="0,10,0,0">
                        <StackPanel>
                            <TextBlock Text="CHAMP SELECT" Foreground="{StaticResource AccentBrush}" FontSize="10" FontWeight="Bold" Margin="0,0,0,6" />
                            <CheckBox Style="{StaticResource SwitchCheck}" IsChecked="{Binding ApplySpells}" AutomationProperties.Name="Apply also sets your summoner spells">
                                <StackPanel>
                                    <TextBlock Text="Apply also sets your summoner spells" FontSize="13" TextWrapping="Wrap" />
                                    <TextBlock Text="op.gg's most played pair for your champion" Foreground="{StaticResource MutedBrush}" FontSize="11" TextWrapping="Wrap" />
                                </StackPanel>
                            </CheckBox>
                            <CheckBox Style="{StaticResource SwitchCheck}" IsChecked="{Binding ApplyItemSet}" AutomationProperties.Name="Apply also adds an item set">
                                <StackPanel>
                                    <TextBlock Text="Apply also adds an item set" FontSize="13" TextWrapping="Wrap" />
                                    <TextBlock Text="In the shop as &quot;LeagueClanker&quot; plus your champion. Your own sets stay." Foreground="{StaticResource MutedBrush}" FontSize="11" TextWrapping="Wrap" />
                                </StackPanel>
                            </CheckBox>
                            <CheckBox Style="{StaticResource SwitchCheck}" IsChecked="{Binding AutoApply}" AutomationProperties.Name="Apply when you lock in">
                                <StackPanel>
                                    <TextBlock Text="Apply when you lock in" FontSize="13" TextWrapping="Wrap" />
                                    <TextBlock Text="No click needed" Foreground="{StaticResource MutedBrush}" FontSize="11" TextWrapping="Wrap" />
                                </StackPanel>
                            </CheckBox>
                        </StackPanel>
                    </Border>
                    <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12,10,12,4" Margin="0,10,0,0">
                        <StackPanel>
                            <TextBlock Text="IN GAME" Foreground="{StaticResource AccentBrush}" FontSize="10" FontWeight="Bold" Margin="0,0,0,6" />
                            <CheckBox Style="{StaticResource SwitchCheck}" IsChecked="{Binding UsePopularItems}" AutomationProperties.Name="Follow op.gg's builds">
                                <StackPanel>
                                    <TextBlock Text="Follow op.gg's builds" FontSize="13" TextWrapping="Wrap" />
                                    <TextBlock Text="Picked for each game. Needs op.gg as the stats source." Foreground="{StaticResource MutedBrush}" FontSize="11" TextWrapping="Wrap" />
                                </StackPanel>
                            </CheckBox>
                            <CheckBox Style="{StaticResource SwitchCheck}" IsChecked="{Binding UseCommunityAugments}" AutomationProperties.Name="Mayhem card win rates">
                                <StackPanel>
                                    <TextBlock Text="Mayhem card win rates" FontSize="13" TextWrapping="Wrap" />
                                    <TextBlock Text="arammayhem.com's numbers and your champion's most taken cards" Foreground="{StaticResource MutedBrush}" FontSize="11" TextWrapping="Wrap" />
                                </StackPanel>
                            </CheckBox>
                            <CheckBox Style="{StaticResource SwitchCheck}" IsChecked="{Binding Compact}" AutomationProperties.Name="Compact mode">
                                <StackPanel>
                                    <TextBlock Text="Compact mode" FontSize="13" TextWrapping="Wrap" />
                                    <TextBlock Text="The next item, what to buy, the matchup and your six slots" Foreground="{StaticResource MutedBrush}" FontSize="11" TextWrapping="Wrap" />
                                </StackPanel>
                            </CheckBox>
                        </StackPanel>
                    </Border>
                    <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12,10,12,4" Margin="0,10,0,0">
                        <StackPanel>
                            <TextBlock Text="GENERAL" Foreground="{StaticResource AccentBrush}" FontSize="10" FontWeight="Bold" Margin="0,0,0,6" />
                            <CheckBox Style="{StaticResource SwitchCheck}" IsChecked="{Binding PlaySounds}" AutomationProperties.Name="Sounds for switches and card offers">
                                <StackPanel>
                                    <TextBlock Text="Sounds for switches and card offers" FontSize="13" TextWrapping="Wrap" />
                                </StackPanel>
                            </CheckBox>
                            <CheckBox Style="{StaticResource SwitchCheck}" IsChecked="{Binding CheckForUpdates}" AutomationProperties.Name="Check for updates at startup">
                                <StackPanel>
                                    <TextBlock Text="Check for updates at startup" FontSize="13" TextWrapping="Wrap" />
                                </StackPanel>
                            </CheckBox>
                        </StackPanel>
                    </Border>

                    <TextBlock Style="{StaticResource SectionHeader}" Text="TROUBLESHOOTING" />
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <Button Style="{StaticResource SmallButton}" Content="Open log" Click="OnOpenLog" Margin="0,0,6,0" />
                        <Button Style="{StaticResource SmallButton}" Content="Open snapshots folder" Click="OnOpenSnapshots" />
                    </StackPanel>
                    <TextBlock Text="&#x2913; in the title bar saves what the app sees right now, with player names replaced. Send the file along when something looks wrong."
                               Foreground="{StaticResource MutedBrush}" FontSize="10" TextWrapping="Wrap" />
                </StackPanel>
            </ScrollViewer>
            </Grid>
        </DockPanel>
    </Border>
</Window>
