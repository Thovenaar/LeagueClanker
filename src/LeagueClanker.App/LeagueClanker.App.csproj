<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- The release pipeline sets the real version with -p:Version=x.y.z -->
    <Version>0.0.0-dev</Version>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\LeagueClanker.Core\LeagueClanker.Core.csproj" />
    <ProjectReference Include="..\LeagueClanker.Vision\LeagueClanker.Vision.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\samples\**\*.json;..\..\samples\**\*.png" Link="samples\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
